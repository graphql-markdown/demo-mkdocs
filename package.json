{
  "name": "demo-mkdocs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./docs/graphql ./site .markdown-copies",
    "generate": "node ./scripts/generate-docs.mjs && node ./scripts/generate-copies.mjs",
    "dev": "npm run generate && mkdocs serve",
    "build": "npm run generate && mkdocs build && node -e \"require('node:fs').cpSync('.markdown-copies','site',{recursive:true})\"",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.3.1",
    "@graphql-markdown/formatters": "^1.3.1",
    "@graphql-markdown/printer-legacy": "^1.21.1",
    "@graphql-markdown/utils": "^1.14.5",
    "@graphql-tools/url-loader": "^10.0.9",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8"
  }
}
